POSTGRES_DB=piancton
POSTGRES_USER=piancton
POSTGRES_PASSWORD=replace-with-a-strong-password

# Docker 镜像源。默认使用 Docker Hub；如 Docker Hub 超时，可替换成可用国内镜像源的完整镜像名。
# 示例格式（请替换为你实际可用的镜像源，不建议盲目照抄公共地址）：
# POSTGRES_IMAGE=镜像源/library/postgres:17-alpine
# PYTHON_BASE_IMAGE=镜像源/library/python:3.12-slim
# NODE_BASE_IMAGE=镜像源/library/node:22-alpine
# NGINX_BASE_IMAGE=镜像源/library/nginx:1.27-alpine
# MEILISEARCH_IMAGE=镜像源/getmeili/meilisearch:v1.13
POSTGRES_IMAGE=postgres:17-alpine
PYTHON_BASE_IMAGE=python:3.12-slim
NODE_BASE_IMAGE=node:22-alpine
NGINX_BASE_IMAGE=nginx:1.27-alpine
MEILISEARCH_IMAGE=getmeili/meilisearch:v1.13

SESSION_COOKIE_SECURE=true
SESSION_TTL_HOURS=168
CORS_ORIGINS=https://images.example.com
MAX_UPLOAD_BYTES=104857600
MAX_IMAGE_PIXELS=80000000
THUMBNAIL_MAX_SIZE=640
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_BLOCK_MINUTES=30
MODEL_PROVIDER=placeholder
MODEL_PROVIDER_ORDER=primary,fallback1,fallback2
MODEL_NAME=
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_TEMPERATURE=0.2
MODEL_TIMEOUT_SECONDS=120
FALLBACK1_NAME=
FALLBACK1_BASE_URL=
FALLBACK1_API_KEY=
FALLBACK1_TEMPERATURE=0.2
FALLBACK2_NAME=
FALLBACK2_BASE_URL=
FALLBACK2_API_KEY=
FALLBACK2_TEMPERATURE=0.2
SEARCH_BACKEND=database
# 启用搜索容器时建议设置：
# COMPOSE_PROFILES=search
# SEARCH_BACKEND=meilisearch
# MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_URL=
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX=images
SEARCH_TIMEOUT_SECONDS=2
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=
EMBEDDING_TIMEOUT_SECONDS=10
EMBEDDING_TOP_N=100
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL_NAME=
RERANKER_TIMEOUT_SECONDS=5
RERANKER_TOP_N=50
SEARCH_TOTAL_TIMEOUT_SECONDS=2.5
SEARCH_MEILISEARCH_TIMEOUT_SECONDS=0.2
SEARCH_EMBEDDING_TIMEOUT_SECONDS=2.5
SEARCH_UNDERSTANDING_TIMEOUT_SECONDS=30
SEARCH_SYSTEM_ROUTING_TIMEOUT_SECONDS=8
SEARCH_SELLING_POINT_TIMEOUT_SECONDS=20
SEARCH_UNDERSTANDING_GRACE_SECONDS=5
SEARCH_UNDERSTANDING_RETRY_ATTEMPTS=1
SEARCH_UNDERSTANDING_RETRY_BACKOFF_SECONDS=1
SEARCH_RERANKER_TIMEOUT_SECONDS=2
SEARCH_CANDIDATE_LIMIT=20
SEARCH_CACHE_TTL_SECONDS=300
SEARCH_CACHE_MAX_ENTRIES=512
MEILI_ENV=production
MEILISEARCH_PORT=127.0.0.1:7700
WEB_PORT=80
