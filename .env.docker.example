POSTGRES_DB=piancton
POSTGRES_USER=piancton
POSTGRES_PASSWORD=replace-with-a-strong-password

# Docker 镜像源。默认使用 Docker Hub；如 Docker Hub 超时，可替换成可用国内镜像源的完整镜像名。
# 示例格式（请替换为你实际可用的镜像源，不建议盲目照抄公共地址）：
# POSTGRES_IMAGE=镜像源/library/postgres:17-alpine
# PYTHON_BASE_IMAGE=镜像源/library/python:3.12-slim
# NODE_BASE_IMAGE=镜像源/library/node:22-alpine
# NGINX_BASE_IMAGE=镜像源/library/nginx:1.27-alpine
# MEILISEARCH_IMAGE=镜像源/getmeili/meilisearch:v1.13
POSTGRES_IMAGE=postgres:17-alpine
PYTHON_BASE_IMAGE=python:3.12-slim
NODE_BASE_IMAGE=node:22-alpine
NGINX_BASE_IMAGE=nginx:1.27-alpine
MEILISEARCH_IMAGE=getmeili/meilisearch:v1.13

# Docker 构建依赖源。国内服务器可改为清华 PyPI 与 npmmirror，避免构建阶段访问境外源。
PIP_INDEX_URL=https://pypi.org/simple
NPM_CONFIG_REGISTRY=https://registry.npmjs.org

SESSION_COOKIE_SECURE=true
SESSION_TTL_HOURS=168
CORS_ORIGINS=https://images.example.com
PUBLIC_BASE_URL=https://images.example.com
MAX_UPLOAD_BYTES=104857600
MAX_IMAGE_PIXELS=80000000
MAX_LONG_IMAGE_PIXELS=160000000
LONG_IMAGE_MIN_ASPECT_RATIO=3.0
THUMBNAIL_MAX_SIZE=640
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_BLOCK_MINUTES=30
SEARCH_BACKEND=database
# 启用搜索容器时建议设置：
# COMPOSE_PROFILES=search
# SEARCH_BACKEND=meilisearch
# MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_URL=
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX=images
SEARCH_TIMEOUT_SECONDS=2
# 火山 Viking AI Search 是项目唯一的在线 AI 能力来源：
# 搜索、问答、推荐、补全、摘要、行为闭环都复用同一应用。真实 Key 只放服务器 .env。
AI_SEARCH_ENABLED=false
AI_SEARCH_SYNC_ENABLED=true
AI_SEARCH_BASE_URL=https://aisearch.cn-beijing.volces.com
AI_SEARCH_API_KEY=
AI_SEARCH_APPLICATION_ID=
AI_SEARCH_SEARCH_PATH=
AI_SEARCH_CHAT_ENABLED=false
AI_SEARCH_CHAT_PATH=
AI_SEARCH_CHAT_DATASET_IDS=
AI_SEARCH_CHAT_TIMEOUT_SECONDS=60
# 个性化推荐：详情页使用下方通用场景；首页猜你喜欢可单独配置场景，留空时复用通用场景。
# 示例：/api/v1/application/<application_id>/scene-xxxxxxxx
AI_SEARCH_RECOMMEND_ENABLED=false
AI_SEARCH_RECOMMEND_PATH=
AI_SEARCH_HOME_RECOMMEND_PATH=
AI_SEARCH_RECOMMEND_TIMEOUT_SECONDS=8
AI_SEARCH_DATASET_ID=
AI_SEARCH_TIMEOUT_SECONDS=8
AI_SEARCH_PAGE_SIZE=10
AI_SEARCH_PUBLIC_BASE_URL=
# 行为闭环：仅同步业务端账号；在火山控制台创建并绑定“用户行为数据集”后填写其 ID。
# 数据集字段至少包含 user_id、item_id、event_type、event_timestamp、event_scene。
AI_SEARCH_BEHAVIOR_ENABLED=false
AI_SEARCH_BEHAVIOR_API_KEY=
AI_SEARCH_BEHAVIOR_DATASET_ID=
AI_SEARCH_BEHAVIOR_SYNC_INTERVAL_SECONDS=30
AI_SEARCH_BEHAVIOR_SYNC_BATCH_SIZE=100
AI_SEARCH_BEHAVIOR_SYNC_STARTUP_DELAY_SECONDS=10
SEARCH_TOTAL_TIMEOUT_SECONDS=180
SEARCH_MEILISEARCH_TIMEOUT_SECONDS=0.2
SEARCH_RESULT_RECOMMENDATION_LIMIT=12
SEARCH_CANDIDATE_LIMIT=20
SEARCH_CACHE_TTL_SECONDS=300
SEARCH_CACHE_MAX_ENTRIES=512
MEILI_ENV=production
MEILISEARCH_PORT=127.0.0.1:7700
WEB_PORT=80
## Image files: local (default), or tos after configuring credentials.
STORAGE_BACKEND=local
TOS_BUCKET=ued-zhiku
TOS_REGION=cn-shanghai
TOS_ENDPOINT=https://tos-cn-shanghai.volces.com
TOS_PREFIX=piancton
TOS_ACCESS_KEY_ID=
TOS_SECRET_ACCESS_KEY=
