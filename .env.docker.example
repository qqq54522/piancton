POSTGRES_DB=piancton
POSTGRES_USER=piancton
POSTGRES_PASSWORD=replace-with-a-strong-password

# Docker 镜像源。默认使用 Docker Hub；如 Docker Hub 超时，可替换成可用国内镜像源的完整镜像名。
# 示例格式（请替换为你实际可用的镜像源，不建议盲目照抄公共地址）：
# POSTGRES_IMAGE=镜像源/library/postgres:17-alpine
# PYTHON_BASE_IMAGE=镜像源/library/python:3.12-slim
# NODE_BASE_IMAGE=镜像源/library/node:22-alpine
# NGINX_BASE_IMAGE=镜像源/library/nginx:1.27-alpine
# MEILISEARCH_IMAGE=镜像源/getmeili/meilisearch:v1.13
POSTGRES_IMAGE=postgres:17-alpine
PYTHON_BASE_IMAGE=python:3.12-slim
NODE_BASE_IMAGE=node:22-alpine
NGINX_BASE_IMAGE=nginx:1.27-alpine
MEILISEARCH_IMAGE=getmeili/meilisearch:v1.13

# Docker 构建依赖源。国内服务器可改为清华 PyPI 与 npmmirror，避免构建阶段访问境外源。
PIP_INDEX_URL=https://pypi.org/simple
NPM_CONFIG_REGISTRY=https://registry.npmjs.org

SESSION_COOKIE_SECURE=true
SESSION_TTL_HOURS=168
CORS_ORIGINS=https://images.example.com
PUBLIC_BASE_URL=https://images.example.com
MAX_UPLOAD_BYTES=104857600
MAX_IMAGE_PIXELS=80000000
MAX_LONG_IMAGE_PIXELS=160000000
LONG_IMAGE_MIN_ASPECT_RATIO=3.0
THUMBNAIL_MAX_SIZE=640
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_BLOCK_MINUTES=30
MODEL_PROVIDER=placeholder
MODEL_PROVIDER_ORDER=primary,fallback1,fallback2
MODEL_NAME=
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_TEMPERATURE=0.2
MODEL_TIMEOUT_SECONDS=120
IMAGE_ANALYSIS_MODEL_NAME=
IMAGE_ANALYSIS_BASE_URL=
IMAGE_ANALYSIS_API_KEY=
IMAGE_ANALYSIS_TEMPERATURE=0.2
ASSET_PHRASE_MODEL_NAME=
ASSET_PHRASE_BASE_URL=
ASSET_PHRASE_API_KEY=
ASSET_PHRASE_TEMPERATURE=0.2
SEARCH_FALLBACK_MODEL_NAME=
SEARCH_FALLBACK_BASE_URL=
SEARCH_FALLBACK_API_KEY=
SEARCH_FALLBACK_TEMPERATURE=0.2
FALLBACK1_NAME=
FALLBACK1_BASE_URL=
FALLBACK1_API_KEY=
FALLBACK1_TEMPERATURE=0.2
FALLBACK2_NAME=
FALLBACK2_BASE_URL=
FALLBACK2_API_KEY=
FALLBACK2_TEMPERATURE=0.2
SEARCH_BACKEND=database
# 启用搜索容器时建议设置：
# COMPOSE_PROFILES=search
# SEARCH_BACKEND=meilisearch
# MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_URL=
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX=images
SEARCH_TIMEOUT_SECONDS=2
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=
EMBEDDING_TIMEOUT_SECONDS=10
EMBEDDING_TOP_N=100
VIKINGDB_ENABLED=false
VIKINGDB_SHADOW_MODE=true
VIKINGDB_BASE_URL=https://api-vikingdb.vikingdb.cn-beijing.volces.com
VIKINGDB_API_KEY=
VIKINGDB_COLLECTION_NAME=piancton_search_knowledge_clean
VIKINGDB_INDEX_NAME=piancton_search_knowledge_idx
VIKINGDB_TIMEOUT_SECONDS=30
VIKINGDB_BATCH_SIZE=100
VIKINGDB_UPSERT_PATH=/api/vikingdb/data/upsert
VIKINGDB_SEARCH_PATH=/api/vikingdb/data/search/multi_modal
VIKINGDB_SEARCH_LIMIT=5
VIKINGDB_KNOWLEDGE_ROUTER_ENABLED=false
VIKINGDB_SKILL_BACKUP_ENABLED=true
VIKINGDB_KNOWLEDGE_MIN_SCORE=0.34
VIKINGDB_KNOWLEDGE_MULTI_SCORE_RATIO=0.9
VIKINGDB_KNOWLEDGE_MULTI_SCORE_GAP=0.08
VIKINGDB_KNOWLEDGE_MAX_MATCHES=3
VIKINGDB_KNOWLEDGE_FALLBACK_ENABLED=false
VIKINGDB_KNOWLEDGE_FALLBACK_MIN_SCORE=0.2
VIKINGDB_KNOWLEDGE_FALLBACK_MAX_MATCHES=1
# 火山 Viking 知识库“知识问答服务”路由：用服务 Prompt 判断卖点，
# 再回本地数据库按已审核素材关系返回图片。真实 Key 只放服务器 .env。
VIKING_KNOWLEDGE_SERVICE_ENABLED=false
VIKING_KNOWLEDGE_SERVICE_BASE_URL=https://api-knowledgebase.mlp.cn-beijing.volces.com
VIKING_KNOWLEDGE_SERVICE_API_KEY=
VIKING_KNOWLEDGE_SERVICE_RESOURCE_ID=
VIKING_KNOWLEDGE_SERVICE_PATH=/api/knowledge/service/chat
VIKING_KNOWLEDGE_SERVICE_TIMEOUT_SECONDS=12
VIKING_KNOWLEDGE_SERVICE_RESULT_LIMIT=6
VIKING_KNOWLEDGE_SERVICE_MAX_MATCHES=4
# 火山 AI Search：用于首页搜索框和素材实时同步。真实 Key 只放服务器 .env。
AI_SEARCH_ENABLED=false
AI_SEARCH_SYNC_ENABLED=true
AI_SEARCH_BASE_URL=https://aisearch.cn-beijing.volces.com
AI_SEARCH_API_KEY=
AI_SEARCH_APPLICATION_ID=
AI_SEARCH_SEARCH_PATH=
AI_SEARCH_CHAT_ENABLED=false
AI_SEARCH_CHAT_PATH=
AI_SEARCH_CHAT_DATASET_IDS=
AI_SEARCH_CHAT_TIMEOUT_SECONDS=20
# 详情页个性化推荐：在 AI Search 控制台创建“详情页推荐”场景后填写场景 API 路径。
# 示例：/api/v1/application/<application_id>/scene-xxxxxxxx
AI_SEARCH_RECOMMEND_ENABLED=false
AI_SEARCH_RECOMMEND_PATH=
AI_SEARCH_RECOMMEND_TIMEOUT_SECONDS=8
AI_SEARCH_DATASET_ID=
AI_SEARCH_TIMEOUT_SECONDS=8
AI_SEARCH_PAGE_SIZE=10
AI_SEARCH_PUBLIC_BASE_URL=
# 行为闭环：仅同步业务端账号；在火山控制台创建并绑定“用户行为数据集”后填写其 ID。
# 数据集字段至少包含 user_id、item_id、event_type、event_timestamp、event_scene。
AI_SEARCH_BEHAVIOR_ENABLED=false
AI_SEARCH_BEHAVIOR_API_KEY=
AI_SEARCH_BEHAVIOR_DATASET_ID=
AI_SEARCH_BEHAVIOR_SYNC_INTERVAL_SECONDS=30
AI_SEARCH_BEHAVIOR_SYNC_BATCH_SIZE=100
AI_SEARCH_BEHAVIOR_SYNC_STARTUP_DELAY_SECONDS=10
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL_NAME=
RERANKER_TIMEOUT_SECONDS=5
RERANKER_TOP_N=50
SEARCH_TOTAL_TIMEOUT_SECONDS=180
SEARCH_MEILISEARCH_TIMEOUT_SECONDS=0.2
SEARCH_EMBEDDING_TIMEOUT_SECONDS=2.5
SEARCH_UNDERSTANDING_TIMEOUT_SECONDS=75
SEARCH_SYSTEM_ROUTING_TIMEOUT_SECONDS=45
SEARCH_SELLING_POINT_TIMEOUT_SECONDS=60
SEARCH_PROOF_POINT_TIMEOUT_SECONDS=45
SEARCH_CANDIDATE_REVIEW_TIMEOUT_SECONDS=45
SEARCH_RESULT_RECOMMENDATION_TIMEOUT_SECONDS=45
SEARCH_RESULT_RECOMMENDATION_LIMIT=12
SEARCH_UNDERSTANDING_GRACE_SECONDS=5
SEARCH_UNDERSTANDING_RETRY_ATTEMPTS=1
SEARCH_UNDERSTANDING_RETRY_BACKOFF_SECONDS=1
SEARCH_RERANKER_TIMEOUT_SECONDS=2
SEARCH_CANDIDATE_LIMIT=20
SEARCH_CANDIDATE_REVIEW_LIMIT=5
SEARCH_CACHE_TTL_SECONDS=300
SEARCH_CACHE_MAX_ENTRIES=512
API_CENTER_MAINTENANCE_ENABLED=true
API_CENTER_MAINTENANCE_INTERVAL_MINUTES=360
API_CENTER_MAINTENANCE_STARTUP_DELAY_SECONDS=300
API_CENTER_MAINTENANCE_MAX_CREDENTIALS_PER_CYCLE=20
API_CENTER_CALL_TRACE_RETENTION_DAYS=30
API_CENTER_HEALTH_CHECK_RETENTION_DAYS=90
MEILI_ENV=production
MEILISEARCH_PORT=127.0.0.1:7700
WEB_PORT=80
## Image files: local (default), or tos after configuring credentials.
STORAGE_BACKEND=local
TOS_BUCKET=ued-zhiku
TOS_REGION=cn-shanghai
TOS_ENDPOINT=https://tos-cn-shanghai.volces.com
TOS_PREFIX=piancton
TOS_ACCESS_KEY_ID=
TOS_SECRET_ACCESS_KEY=
