APP_NAME=标签图片仓库
APP_ENV=development
API_PREFIX=/api
DATABASE_URL=sqlite:///../data/piancton.db
STORAGE_DIR=../storage/images
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=168
MAX_UPLOAD_BYTES=104857600
MAX_IMAGE_PIXELS=80000000
THUMBNAIL_MAX_SIZE=640
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_BLOCK_MINUTES=30
MODEL_PROVIDER=placeholder
MODEL_NAME=
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=60
IMAGE_ANALYSIS_MODEL_NAME=
IMAGE_ANALYSIS_BASE_URL=
IMAGE_ANALYSIS_API_KEY=
IMAGE_ANALYSIS_TEMPERATURE=0.2
ASSET_PHRASE_MODEL_NAME=
ASSET_PHRASE_BASE_URL=
ASSET_PHRASE_API_KEY=
ASSET_PHRASE_TEMPERATURE=0.2
SEARCH_FALLBACK_MODEL_NAME=
SEARCH_FALLBACK_BASE_URL=
SEARCH_FALLBACK_API_KEY=
SEARCH_FALLBACK_TEMPERATURE=0.2
SEARCH_BACKEND=database
# 本地如单独启动 Meilisearch：
# SEARCH_BACKEND=meilisearch
# MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_URL=
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX=images
SEARCH_TIMEOUT_SECONDS=2
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=
EMBEDDING_TIMEOUT_SECONDS=10
EMBEDDING_TOP_N=100
VIKINGDB_ENABLED=false
VIKINGDB_SHADOW_MODE=true
VIKINGDB_BASE_URL=https://api-vikingdb.vikingdb.cn-beijing.volces.com
VIKINGDB_API_KEY=
VIKINGDB_COLLECTION_NAME=piancton_search_knowledge_clean
VIKINGDB_INDEX_NAME=piancton_search_knowledge_idx
VIKINGDB_TIMEOUT_SECONDS=30
VIKINGDB_BATCH_SIZE=100
VIKINGDB_UPSERT_PATH=/api/vikingdb/data/upsert
VIKINGDB_SEARCH_PATH=/api/vikingdb/data/search/multi_modal
VIKINGDB_SEARCH_LIMIT=5
VIKINGDB_KNOWLEDGE_ROUTER_ENABLED=false
VIKINGDB_SKILL_BACKUP_ENABLED=true
VIKINGDB_KNOWLEDGE_MIN_SCORE=0.34
VIKINGDB_KNOWLEDGE_MULTI_SCORE_RATIO=0.9
VIKINGDB_KNOWLEDGE_MULTI_SCORE_GAP=0.08
VIKINGDB_KNOWLEDGE_MAX_MATCHES=3
# 火山 Viking 知识库“知识问答服务”路由：用服务 Prompt 判断卖点，
# 再回本地数据库按已审核素材关系返回图片。真实 Key 只放本机/服务器 .env。
VIKING_KNOWLEDGE_SERVICE_ENABLED=false
VIKING_KNOWLEDGE_SERVICE_BASE_URL=https://api-knowledgebase.mlp.cn-beijing.volces.com
VIKING_KNOWLEDGE_SERVICE_API_KEY=
VIKING_KNOWLEDGE_SERVICE_RESOURCE_ID=
VIKING_KNOWLEDGE_SERVICE_PATH=/api/knowledge/service/chat
VIKING_KNOWLEDGE_SERVICE_TIMEOUT_SECONDS=12
VIKING_KNOWLEDGE_SERVICE_RESULT_LIMIT=6
VIKING_KNOWLEDGE_SERVICE_MAX_MATCHES=4
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL_NAME=
RERANKER_TIMEOUT_SECONDS=5
RERANKER_TOP_N=50
SEARCH_TOTAL_TIMEOUT_SECONDS=2.5
SEARCH_MEILISEARCH_TIMEOUT_SECONDS=0.2
SEARCH_EMBEDDING_TIMEOUT_SECONDS=1.8
SEARCH_UNDERSTANDING_TIMEOUT_SECONDS=75
SEARCH_SYSTEM_ROUTING_TIMEOUT_SECONDS=15
SEARCH_SELLING_POINT_TIMEOUT_SECONDS=25
SEARCH_PROOF_POINT_TIMEOUT_SECONDS=20
SEARCH_CANDIDATE_REVIEW_TIMEOUT_SECONDS=20
SEARCH_CANDIDATE_REVIEW_LIMIT=5
SEARCH_RERANKER_TIMEOUT_SECONDS=1.4
SEARCH_CANDIDATE_LIMIT=20
SEARCH_CACHE_TTL_SECONDS=300
SEARCH_CACHE_MAX_ENTRIES=512
