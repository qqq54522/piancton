APP_NAME=标签图片仓库
APP_ENV=development
API_PREFIX=/api
DATABASE_URL=sqlite:///../data/piancton.db
STORAGE_DIR=../storage/images
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=168
MAX_UPLOAD_BYTES=104857600
MAX_IMAGE_PIXELS=80000000
THUMBNAIL_MAX_SIZE=640
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_BLOCK_MINUTES=30
MODEL_PROVIDER=placeholder
MODEL_NAME=
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=60
SEARCH_BACKEND=database
# 本地如单独启动 Meilisearch：
# SEARCH_BACKEND=meilisearch
# MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_URL=
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX=images
SEARCH_TIMEOUT_SECONDS=2
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=
EMBEDDING_TIMEOUT_SECONDS=10
EMBEDDING_TOP_N=100
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL_NAME=
RERANKER_TIMEOUT_SECONDS=5
RERANKER_TOP_N=50
