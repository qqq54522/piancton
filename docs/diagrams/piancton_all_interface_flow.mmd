flowchart LR
  %% 卖点智库全界面低保真流程图代码版
  %% 复制到支持 Mermaid 的 Markdown 代码块中即可渲染

  subgraph A[入口与应用外壳]
    A1["登录页 /login<br/>用户名/密码<br/>登录按钮<br/>失败提示"]
    A2["鉴权守卫 ProtectedRoute<br/>未登录跳转登录<br/>已登录进入 Layout"]
    A3["应用外壳 Layout<br/>左侧导航<br/>账号菜单<br/>移动端菜单<br/>页面内容区"]
    A4{"角色权限"}
    A5["404 NotFound<br/>无匹配路由"]
  end

  subgraph B[业务用户主流程]
    B1["素材库首页 /<br/>全局搜索框<br/>渠道/场景筛选<br/>卖点/证明点筛选<br/>排序<br/>素材瀑布流"]
    B2["搜索加载/错误态<br/>进度提示<br/>重新尝试<br/>清除搜索"]
    B3["搜索结果区<br/>动态匹配卖点<br/>渠道推荐说明<br/>项目篮<br/>结果卡片<br/>反馈面板"]
    B4["素材详情 /image/:id<br/>大图预览<br/>素材信息<br/>身份码<br/>相关素材推荐"]
    B5["预览/下载<br/>预览不计数<br/>下载计数<br/>按版本下载"]
    B6["素材库 Agent<br/>个人会话<br/>加入图片上下文<br/>解释卖点/场景/话术<br/>自然日重置"]
    B7["图片身份码精确查找<br/>解析当前图片身份码<br/>直接返回详情"]
  end

  subgraph C[设计师 / 管理员素材维护流]
    C1["上传主图弹窗<br/>选图片<br/>选渠道<br/>选卖点/证明点<br/>填写素材话术<br/>上传并发布"]
    C2["上传前 AI 话术生成<br/>选择生成数量<br/>按图片和卖点生成候选话术<br/>人工可修改"]
    C3["AI 分析面板<br/>画面事实<br/>场景判断<br/>卖点建议<br/>错误状态"]
    C4["素材详情设计师视图<br/>大图预览<br/>信息面板<br/>重新分析<br/>删除入口"]
    C5["素材工作台<br/>版本管理<br/>来源链接<br/>业务分类<br/>卖点关系审核<br/>素材话术审核"]
    C6["版本弹窗/删除弹窗<br/>新增版本<br/>设为主图<br/>删除派生图"]
    C7["回收站 /trash<br/>已删除图片<br/>恢复<br/>永久删除"]
  end

  subgraph D[管理员后台治理]
    D1["卖点管理 /admin/concepts<br/>六大体系<br/>16 个卖点<br/>公共话术<br/>启用/停用"]
    D2["渠道管理 /admin/channels<br/>渠道标签<br/>渠道家族<br/>尺寸语境<br/>渠道话术<br/>推荐说明"]
    D3["API 中心 /admin/api-center<br/>健康度监测<br/>API 管理<br/>调度配置<br/>调用链路日志"]
    D4["搜索运营 /admin/search-ops<br/>总览/治理<br/>待处理问题<br/>AI 待审核<br/>概念健康度<br/>素材缺口/反馈归档"]
    D5["身份码管理 /admin/identity-codes<br/>一图一码<br/>仅活动图片<br/>复制<br/>查看图片"]
    D6["使用统计 /admin/usage<br/>登录<br/>页面访问<br/>下载<br/>活跃用户"]
    D7["用户管理 /admin/users<br/>创建账号<br/>角色切换<br/>启停用户<br/>重置密码"]
    D8["审计日志 /admin/audit<br/>后台操作<br/>非敏感变更摘要<br/>排查记录"]
  end

  A1 -->|登录成功| A2 --> A3 --> A4
  A4 -->|business| B1
  A4 -->|designer/admin| C1
  A4 -->|admin| D3
  A3 --> A5

  B1 -->|输入搜索词| B2 --> B3
  B1 -->|手动筛选| B3
  B3 -->|点击素材卡片| B4
  B4 -->|预览/下载| B5
  B4 -->|加入上下文| B6
  B7 -->|确定性跳转| B4

  C1 -->|生成话术| C2 --> C1
  C1 -->|上传成功| C4
  C4 -->|重新分析| C3
  C4 -->|维护素材| C5
  C5 -->|版本操作| C6
  C5 -->|删除| C7
  C7 -->|恢复| C4

  D1 -.公共话术.-> B1
  D2 -.渠道话术.-> B1
  D3 -.模型任务调度.-> B2
  D3 -.图片分析/Agent.-> C3
  D4 -.搜索反馈和缺口.-> D1
  D5 -.图片身份码精确查找.-> B7
  D6 -.使用事件.-> B1
  D7 -.角色权限.-> A4
  D8 -.后台审计.-> D3
